---
layout: layouts/base.njk
---
{% import "macros.njk" as m %}
<section class="hero">
  <div class="hero__content">
    <p class="hero__eyebrow">Master · Droit Privé Général · USPN</p>
    <h1>{{ site.associationName }}</h1>
    <p class="hero__tagline">{{ site.tagline }}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/presentation/">Découvrir l'association</a>
      <a class="btn btn--secondary" href="/contact/">Nous rejoindre</a>
    </div>
  </div>
  <div class="hero__seal">
    <img src="/assets/images/logo.jpg" alt="{{ site.associationName }}">
  </div>
</section>

<section class="section">
  {{ m.chapterMark("Prochainement") }}
  {%- if collections.events.length %}
  <ul class="card-list">
    {%- for event in collections.events %}
    {%- if loop.index <= 3 %}
    <li class="card">
      <p class="card__meta">{{ event.data.date | dateFr }}</p>
      <h3>{{ event.data.title }}</h3>
      <p>{{ event.data.description }}</p>
    </li>
    {%- endif %}
    {%- endfor %}
  </ul>
  <p><a href="/evenements/">Voir tous les événements →</a></p>
  {%- else %}
  <p>Aucun événement pour le moment.</p>
  {%- endif %}
</section>
