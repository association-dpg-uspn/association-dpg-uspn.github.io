---
layout: layouts/base.njk
---
{% import "macros.njk" as m %}
<article class="content">
  <h1>{{ title }}</h1>
  {{ content | safe }}

  {%- if instagram or linkedin %}
  <ul class="socials">
    {%- if instagram %}
    <li>
      <a class="socials__link" href="{{ instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.3"/><circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none"/></svg>
      </a>
    </li>
    {%- endif %}
    {%- if linkedin %}
    <li>
      <a class="socials__link" href="{{ linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><rect x="2.5" y="2.5" width="19" height="19" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="6.4" y="9.6" width="2.4" height="8" /><circle cx="7.6" cy="6.6" r="1.5" /><path d="M11.6 17.6V9.6h2.3v1.2c.6-.9 1.5-1.4 2.7-1.4 2 0 3.2 1.3 3.2 3.7v4.5h-2.4v-4.1c0-1.2-.5-1.9-1.5-1.9-.9 0-1.6.6-1.9 1.3-.1.2-.1.5-.1.8v3.9z"/></svg>
      </a>
    </li>
    {%- endif %}
  </ul>
  {%- endif %}
</article>

{%- if showBureau and collections.bureau.length %}
<section class="section">
  {{ m.chapterMark("Le bureau") }}
  <ul class="card-list card-list--bureau">
    {%- for member in collections.bureau %}
    <li class="card card--member">
      {%- if member.data.photo %}
      <img class="card__photo" src="{{ member.data.photo }}" alt="{{ member.data.name }}">
      {%- endif %}
      <h3>{{ member.data.name }}</h3>
      <p class="card__meta">{{ member.data.role }}</p>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

{%- if showPartners and collections.partners.length %}
<section class="section">
  {{ m.chapterMark("Nos partenaires") }}
  <ul class="card-list card-list--partners">
    {%- for partner in collections.partners %}
    <li class="card card--partner">
      {%- if partner.data.logo %}
      <img class="card__logo" src="{{ partner.data.logo }}" alt="{{ partner.data.name }}">
      {%- endif %}
      {%- if partner.data.link %}
      <h3><a href="{{ partner.data.link }}">{{ partner.data.name }}</a></h3>
      {%- else %}
      <h3>{{ partner.data.name }}</h3>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}
