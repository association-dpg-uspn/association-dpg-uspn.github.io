{% macro chapterMark(label) %}
<div class="chapter-mark">
  <h2>{{ label }}</h2>
  <div class="chapter-mark__rule"></div>
</div>
{% endmacro %}

{% macro eventCard(event) %}
<li class="card">
  <p class="card__meta">{{ event.data.date | dateFr }}</p>
  <h3>{{ event.data.title }}</h3>
  <p>{{ event.data.description }}</p>
  {%- if event.data.link %}
  <p><a href="{{ event.data.link }}">En savoir plus →</a></p>
  {%- endif %}
</li>
{% endmacro %}
