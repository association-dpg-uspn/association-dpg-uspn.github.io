---
layout: layouts/base.njk
title: Événements
---
{% import "macros.njk" as m %}
<article class="content">
  <h1>Événements</h1>

  <section class="section">
    {{ m.chapterMark("À venir") }}
    {%- if collections.upcomingEvents.length %}
    <ul class="card-list">
      {%- for event in collections.upcomingEvents %}
      {{ m.eventCard(event) }}
      {%- endfor %}
    </ul>
    {%- else %}
    <p>Aucun événement à venir pour le moment.</p>
    {%- endif %}
  </section>

  {%- if collections.pastEvents.length %}
  <section class="section">
    {{ m.chapterMark("Événements passés") }}
    <ul class="card-list">
      {%- for event in collections.pastEvents %}
      {{ m.eventCard(event) }}
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
</article>
